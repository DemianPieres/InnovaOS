# ════════════════════════════════════════════════════════
# InnovaOS — Variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# NUNCA commitear .env.local al repositorio.
# ════════════════════════════════════════════════════════

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/innovaos?retryWrites=true&w=majority

# JWT del sistema (usuarios de tenants)
APP_JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_segura
APP_JWT_EXPIRES_IN=8h
REFRESH_TOKEN_SECRET=cambia_esto_por_otra_clave_muy_larga
REFRESH_TOKEN_EXPIRES_IN=7d

# JWT exclusivo para MAXADMIN
MAXADMIN_JWT_SECRET=clave_exclusiva_para_maxadmin_muy_larga
MAXADMIN_JWT_EXPIRES_IN=8h

# Credenciales del primer MAXADMIN (usadas por scripts/seed-maxadmin.ts)
MAXADMIN_EMAIL=tu@email.com
MAXADMIN_PASSWORD=contrasena_muy_segura

# URL pública de la app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integraciones futuras
WHATSAPP_API_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Configuración runtime
NODE_ENV=development
